# Copy to .env and adjust. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to SQLite when unset. Examples:
#   postgres://user:pass@localhost:5432/ecommerce   (pip install "psycopg[binary]")
#   mysql://user:pass@localhost:3306/ecommerce      (pip install mysqlclient)
# DATABASE_URL=

# Origins allowed to send CSRF-protected requests (the React app in production).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT lifetimes (defaults shown).
# JWT_ACCESS_MINUTES=10
# JWT_REFRESH_DAYS=7

# S3-compatible storage for uploaded images (production). Leave unset to store
# files in backend/media/ (fine for development).
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
